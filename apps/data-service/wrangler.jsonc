/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "data-service",
	"main": "src/index.ts",
	"compatibility_date": "2025-06-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
	},
	"env": {
		"stage": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_id": "fa8e82f4-aa40-4020-b1d2-73a998522ae0",
					"remote": true
				},
			],
			"kv_namespaces": [
				{
					"binding": "CACHE",
					"id": "2c97779b045745be999ff53f59ee1c0e",
					"remote": true
				}
			],
			"queues": {
				"consumers": [
					{
						"queue": "smart-links-queue-stage",
					}
				],
				"producers": [
					{
						"binding": "QUEUE",
						"queue": "smart-links-queue-stage",
					}
				]
			},
			"workflows": [
				{
					"binding": "DESTINATION_EVALUATION_WORKFLOW",
					"name": "destination-evaluation-workflow",
					"class_name": "DestinationEvaluationWorkflow"
				}
			],
			"browser": {
				"binding": "VIRTUAL_BROWSER",
			},
			"ai": {
				"binding": "AI",
			},
			"durable_objects": {
				"bindings": [
					{
						"class_name": "LinkClickTracker",
						"name": "LINK_CLICK_TRACKER_OBJECT"
					},
					{
						"name": "EVALUATION_SCHEDULAR",
						"class_name": "EvaluationScheduler"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_classes": [
						"EvaluationScheduler"
					],
				},
				{
					"tag": "v2",
					"new_sqlite_classes": [
						"LinkClickTracker"
					]
				},
			]
		},
		"production": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_id": "96980027-7a5a-427b-b7f8-035568ebf05b",
				},
			],
			"kv_namespaces": [
				{
					"binding": "CACHE",
					"id": "29388813b5ed4e13968330d698b011ea",
				}
			],
			"queues": {
				"consumers": [
					{
						"queue": "smart-links-queue-production",
					}
				],
				"producers": [
					{
						"binding": "QUEUE",
						"queue": "smart-links-queue-production",
					}
				]
			},
			"workflows": [
				{
					"binding": "DESTINATION_EVALUATION_WORKFLOW",
					"name": "destination-evaluation-workflow-production",
					"class_name": "DestinationEvaluationWorkflow"
				}
			],
			"browser": {
				"binding": "VIRTUAL_BROWSER",
			},
			"ai": {
				"binding": "AI",
			},
			"durable_objects": {
				"bindings": [
					{
						"class_name": "LinkClickTracker",
						"name": "LINK_CLICK_TRACKER_OBJECT"
					},
					{
						"name": "EVALUATION_SCHEDULAR",
						"class_name": "EvaluationScheduler"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_classes": [
						"EvaluationScheduler"
					],
				},
				{
					"tag": "v2",
					"new_sqlite_classes": [
						"LinkClickTracker"
					]
				},
			]
		}
	}
}